}\n.hero h1{font-size:4rem;margin:0;font-weight:700}\n.hero p{font-size:1.5rem;margin:1rem 0}\n.btn{display:inline-block;background:#2e7d32;padding:1rem 2rem;border-radius:8px;color:#fff;text-decoration:none;font-weight:600;margin:0.5rem}\n.btn-primary{background:#1b5e20}\n.btn-secondary{background:#4caf50}\n.container{max-width:1280px;margin:auto;padding:2rem}\n.ellipsis{letter-spacing:2px;font-weight:400;font-size:1rem}\n.row{display:flex;gap:1.5rem;flex-wrap:wrap;margin:1.5rem 0}\n.card{background:#fff;border-radius:20px;box-shadow:0 4px 12px rgba(0,0,0,.1);padding:1.5rem;flex:1;min-width:260px;transition:transform .3s ease;cursor:pointer}\n.card:hover{transform:translateY(-8px)}\n.card h3{margin-top:0;font-size:1.25rem;color:#1b5e20}\n.card p{font-size:1rem;color:#555}\n.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem}\n.gallery img{width:100%;height:auto;border-radius:20px;object-fit:cover}\n.footer{background:#1b5e20;color:#fff;text-align:center;padding:2rem 1rem}\n</style></section><footer class=\"site-foot\">© 2026 Test Bakery. All rights reserved.<br><span style=\"opacity:.75;font-size:.82rem\">Website crafted with MAT LEADS AI Website Studio — created by Ebube John Okoye.</span></footer><script>function showPage(i){document.querySelectorAll('.pg').forEach(function(s,idx){s.style.display=idx===i?'block':'none'});document.querySelectorAll('.nav-a').forEach(function(a,idx){a.classList.toggle('active',idx===i)});window.scrollTo(0,0);return false;}</script></body></html>",
